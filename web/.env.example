# "http" talks to the Arogya backend (default in Docker). "mock" runs fully in the browser with demo data.
VITE_API_MODE=http
# Same-origin paths (Traefik routes /api and /auth). Only change if the API lives on another origin.
VITE_API_BASE_URL=/api/v1
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=oralscreen
VITE_KEYCLOAK_CLIENT=oralscreen-app
# Login screen shows one-click demo accounts (hackathon demo). Set false for real deployments.
VITE_SHOW_DEMO_USERS=true
VITE_DEMO_PASSWORD=OralScreen@2026

# Only for `npm run dev` / `npm run preview` outside Docker: where the backend runs.
DEV_BACKEND_URL=https://localhost
