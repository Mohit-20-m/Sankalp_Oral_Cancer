# Copy to .env and change the passwords before showing this to anyone outside your team.
# Every value has a working default in docker-compose.yml, so `docker compose up --build` also works without .env.

PUBLIC_HOST=localhost                    # or your laptop's LAN IP, so a phone on the same Wi-Fi can connect
HTTP_PORT=80
HTTPS_PORT=443
OS_S3_PUBLIC_ENDPOINT=https://localhost       # photo links go through Traefik; use https://<LAN-IP> for a phone
CAPTURE_BASE_URL=                        # web app "Use my phone" QR base, e.g. https://192.168.1.20 (empty = PUBLIC_HOST)
WEB_SHOW_DEMO_USERS=true                 # one-click demo accounts on the web login page

# ── passwords (CHANGE) ──
POSTGRES_PASSWORD=postgres-superuser-pw
OS_DB_OWNER_PASSWORD=oralscreen-owner-pw
OS_DB_APP_PASSWORD=oralscreen-app-pw
KEYCLOAK_DB_PASSWORD=keycloak-db-pw
MLFLOW_DB_PASSWORD=mlflow-db-pw
HAPI_DB_PASSWORD=hapi-db-pw
KEYCLOAK_ADMIN_PASSWORD=Admin@OralScreen2026
MINIO_ROOT_USER=oralscreen
MINIO_ROOT_PASSWORD=oralscreen-minio-secret
GRAFANA_ADMIN_PASSWORD=Admin@OralScreen2026
VAULT_APP_TOKEN=oralscreen-svc-change-me-2026   # must NOT start with "s." or "hvs."

# ── messaging: sandbox (messages stored + shown in the admin API) or twilio (real SMS / voice calls) ──
OS_MESSAGING_MODE=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                      # e.g. +1XXXXXXXXXX (trial accounts can only send to verified numbers)
PUBLIC_WEBHOOK_BASE=                     # https://<id>.ngrok-free.app  (from http://localhost:4040 with --profile tunnel)
NGROK_AUTHTOKEN=

# ── optional features ──
OS_SEED_DEMO=true                        # demo villages, staff, 120 background screenings, Shekhar + Lalitha
OS_OTEL_ENABLED=false                    # true when running --profile monitoring (traces to Grafana Tempo)
OS_HAPI_URL=                             # http://hapi:8080/fhir when running --profile hapi
INSTALL_EXTRAS=true                      # Evidently drift reports + Flower; false saves ~350 MB of image size
OS_LOG_LEVEL=INFO
