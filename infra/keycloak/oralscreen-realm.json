{
  "realm": "oralscreen",
  "enabled": true,
  "displayName": "OralScreen",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "passwordPolicy": "length(10) and upperCase(1) and digits(1) and specialChars(1) and notUsername",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "offlineSessionIdleTimeout": 2592000,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "asha",
        "description": "ASHA / community health worker"
      },
      {
        "name": "nurse",
        "description": "PHC staff nurse"
      },
      {
        "name": "specialist",
        "description": "Oral medicine specialist"
      },
      {
        "name": "clinical_lead",
        "description": "Clinical lead (approves rules & models)"
      },
      {
        "name": "district_officer",
        "description": "District health officer (aggregates only)"
      },
      {
        "name": "admin",
        "description": "Platform administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "oralscreen-app",
      "name": "OralScreen apps (phone, specialist console, dashboards)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://localhost/*",
        "http://localhost:*/*",
        "oralscreen://callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "facility_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "facility_id",
            "claim.name": "facility_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    }
  ],
